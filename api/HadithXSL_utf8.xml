	<msxsl:script language="JScript" implements-prefix="user">
		function testnod(ss,zz)
		{
		  var testpos
		  var testval
		  var flagg
		  testpos=zz/2
		  testval=testpos-(parseInt(testpos))
		  if(testval>0)
			return 3
		  
		  testpos=ss/2
		  testval=testpos-(parseInt(testpos))
		  if(testpos>=1)
		  {
			  if (testval>0)
				flagg=1
			  else if(testval==0)
				flagg=0
		  }
		  else
		  {
			  if(zz==1)
				flagg=3
			  else
				flagg=1
		  }
		  return flagg
		}
		
		var nFootNote =0
		var sFootNote = ""

		function GetFootNote()
		{
			return nFootNote;
		}
		function GetNextFootNote()
		{
			nFootNote = nFootNote + 1
			return nFootNote
		}
		function AddFootNote(Name)
		{
			var ID = GetNextFootNote();
			
			sFootNote +=  "&lt;a href=\"#S_Foot_"+ID+"\" name=\"Foot_"+ID+"\" class=\"FootNoteLink\"&gt;(" +ID+ ")&lt;/a&gt; &lt;span class=\"FootNote\"&gt;" + Name + "&lt;/span&gt; &lt;br/&gt;";
			return ID;
		}
		
		function GetFootNotes()
		{
			if(nFootNote != 0 )
			{
				sFootNote = "&lt;br/&gt;&lt;HR/&gt;"+sFootNote
			}
			return sFootNote;
		}
		function GetNodeInnerText(node)
		{           	

			return node;
		}

  
	</msxsl:script>
	     
</xsl:stylesheet>
