	<xsl:template match="TakreegMutonBook">
	<xsl:variable name="ParentName"><xsl:value-of select="local-name(parent::*)" /></xsl:variable>
	<!--<xsl:if test="$ParentName!='TakhreegMainBook'">-->	
		<xsl:choose>
		<xsl:when test="@BookName">	
			<!-- if the cur book not the first one there is no need to add the begining word أخرجه or أورده  but add و-->		
			<xsl:if test="position()!=1">	
				<xsl:choose>
				<xsl:when test="@WithoutAnd">
					
				</xsl:when>
				<xsl:otherwise>
					<xsl:text> و</xsl:text>	
				</xsl:otherwise>
				</xsl:choose>
						
			</xsl:if>	
			<!--test done on book -->
			<xsl:choose>
				<!-- if the cur book is المطالب العالية then we have to begin by أورده -->
				<xsl:when test="@BookID[.='26']">
					<xsl:text>أورده  </xsl:text>
				</xsl:when>
				<xsl:otherwise>
					<xsl:choose>
					<!-- if the cur book is the first book then begin by أخرجه-->
					<xsl:when test="position()=1">
						<xsl:text>أخرجه  </xsl:text>
					</xsl:when>
					<!-- if the preceding book was المطالب العالية then rewrite أخرجه-->
					<xsl:when test="preceding-sibling::TakreegMutonBook/@BookID=26">
						<xsl:text>أخرجه  </xsl:text>
					</xsl:when>
					<xsl:otherwise>
					
					</xsl:otherwise>
					</xsl:choose>
				</xsl:otherwise>		
			</xsl:choose>

			<!-- test on the author -->
			<xsl:choose>
				<!--if Mosanef of the hadith not the author of the book then we have to add the following statment -->
				<xsl:when test="@Mosanef">
					<xsl:value-of select="@Mosanef"/>
					<xsl:text> في زوائده على "</xsl:text>
					<xsl:value-of select="@BookTitle"/>	
				</xsl:when>	
				<!--if the content in the introduction -->
				<xsl:when test="@Introduction">
					<xsl:value-of select="@Author"/>
					<xsl:text> في "مقدمة صحيحه</xsl:text>
				</xsl:when>	
				<!-- the normal case Mosanef is the author-->
				<xsl:otherwise>
					<xsl:value-of select="@Author"/>
					<xsl:if test="@WithoutAnd='1'">	
						<xsl:text> وهو</xsl:text>
					</xsl:if>
					<xsl:text> في "</xsl:text>
					<xsl:value-of select="@BookName"/>	
				</xsl:otherwise>
			</xsl:choose>				
				
			<xsl:text>"</xsl:text>
		</xsl:when>
		<xsl:otherwise>
			<br/>
		</xsl:otherwise>
		</xsl:choose>	
	<!--</xsl:if>-->					
		<xsl:apply-templates/>					

	</xsl:template>
	
	
